    "content:new": "tsx src/content/scaffold.ts"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.2",
    "@radix-ui/react-dropdown-menu": "^2.1.2",
    "@radix-ui/react-tabs": "^1.1.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.36.0",
    "gray-matter": "^4.0.3",
    "js-yaml": "^4.3.2",
    "mermaid": "^12.0.0",
    "next": "^15.1.0",
    "next-auth": "5.0.0-beta.25",
    "next-mdx-remote": "^6.0.0",
    "postgres": "^3.4.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "remark-gfm": "^4.0.1",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.1",
