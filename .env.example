# Copy this file to .env and fill in real values for local development.
# docker compose up reads these directly.

# --- App ---
NODE_ENV=development
APP_PORT=3000

# --- Database (Postgres 17 + pgvector) ---
POSTGRES_USER=interchange
POSTGRES_PASSWORD=interchange
POSTGRES_DB=interchange
POSTGRES_PORT=5432
# Full connection string used by the app/migrate services when not composed above
DATABASE_URL=postgres://interchange:interchange@localhost:5432/interchange

# --- Auth.js ---
# openssl rand -base64 32
NEXTAUTH_SECRET=change-me
NEXTAUTH_URL=http://localhost:3000

# Email magic link (Mailpit catches outgoing mail in dev)
EMAIL_SERVER=smtp://mailpit:1025
EMAIL_FROM=noreply@interchange.local
MAILPIT_UI_PORT=8025
MAILPIT_SMTP_PORT=1025

# OAuth providers
GITHUB_ID=
GITHUB_SECRET=
GOOGLE_ID=
GOOGLE_SECRET=

# --- Anthropic API (AI tutor) ---
# Leave blank to run with AI features hidden.
ANTHROPIC_API_KEY=
# Model id — never hard-code this in source. Check https://docs.claude.com for current names.
ANTHROPIC_MODEL=
# Per-user daily token budget for AI features (input+output tokens)
AI_DAILY_TOKEN_BUDGET=200000

# --- Search / embeddings ---
# Provider used for embeddings behind the swappable provider interface (e.g. "anthropic", "voyage")
EMBEDDINGS_PROVIDER=

# --- Observability (optional) ---
LOG_LEVEL=info
